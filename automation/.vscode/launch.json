{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: UV Run Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/quiz/main.py",
            "args": [
                "--take", "1",
                "--offset", "346",
                "--intermediate"
            ],
            "console": "integratedTerminal",
            "python": "${command:python.interpreterPath}",
            "purpose": [
                "debug-in-terminal"
            ],
            "env": {
                "PYTHONUNBUFFERED": "1"
            },
            "linux": {
                "python": "${workspaceFolder}/.venv/bin/python"
            },
        }
    ]
}